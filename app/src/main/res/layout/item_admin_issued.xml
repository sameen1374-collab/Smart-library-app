<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_white_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="1dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        tools:text="The Great Gatsby" />

    <TextView
        android:id="@+id/tvUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="@color/brown_primary"
        tools:text="Issued to: sameen@gmail.com" />

    <TextView
        android:id="@+id/tvDates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        tools:text="Issued: 8/3/2026 • Due: 8/17/2026" />

    <TextView
        android:id="@+id/tvFineStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/action_red"
        android:visibility="gone"
        tools:text="⚠ Overdue — Fine: Rs 20"
        tools:visibility="visible" />

</LinearLayout>