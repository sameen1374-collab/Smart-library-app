<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brown_primary"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Library"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, User"
                android:textColor="@color/tan_lighter"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMembership"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnLogout"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:text="Membership"
            android:textSize="12sp"
            android:backgroundTint="@color/brown_dark"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Logout"
            android:textSize="12sp"
            android:backgroundTint="@color/brown_dark"
            android:textColor="@color/text_white" />
    </RelativeLayout>

    <!-- Tab Bar (horizontally scrollable to fit all 5 tabs) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_white_card"
        android:elevation="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvTabSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textSize="13sp"
                    android:textColor="@color/brown_primary"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/underlineSearch"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/brown_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabIssue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvTabIssue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Issue"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted" />

                <View
                    android:id="@+id/underlineIssue"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvTabReturn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Return"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted" />

                <View
                    android:id="@+id/underlineReturn"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabRecords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvTabRecords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Records"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted" />

                <View
                    android:id="@+id/underlineRecords"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvTabOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted" />

                <View
                    android:id="@+id/underlineOnline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent" />
            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Content area: each tab's screen loads in here -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>