<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Photo header -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_login_header"
            android:contentDescription="@null" />

        <!-- Form panel, overlapping the header slightly with rounded top corners -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_form_panel"
            android:layout_marginTop="-24dp"
            android:padding="24dp">

            <!-- Small logo + app name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/logo_smart_library"
                    android:contentDescription="@null" />

            </LinearLayout>

            <!-- Login / Signup tab switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/tabLogin"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Login"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:background="@drawable/bg_tab_selected"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tabSignup"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Signup"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Full Name"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"
                android:layout_marginBottom="14dp"
                android:visibility="gone"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"/>

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:text="Forgot password?"
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnMainAction"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="LOGIN"
                android:backgroundTint="@color/brown_primary"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Kept for LoginActivity.java logic; no longer visually needed since tabs handle switching -->
            <TextView
                android:id="@+id/tvToggleMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? Sign Up"
                android:textColor="@color/brown_primary"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:textSize="13sp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>