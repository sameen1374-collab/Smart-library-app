<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/brown_primary"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Membership"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Membership Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_white_card"
        android:layout_margin="16dp"
        android:padding="20dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvCurrentTier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Plan: Basic"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/brown_primary" />

        <TextView
            android:id="@+id/tvBookLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Book Limit: 2 books at a time"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tvLoanDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Loan Duration: 14 days"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tvFineRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fine Rate: Rs 10/day"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

    </LinearLayout>

    <!-- Actions Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_white_card"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="20dp"
        android:elevation="2dp">

        <Button
            android:id="@+id/btnUpgradeDowngrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upgrade to Premium"
            android:backgroundTint="@color/brown_primary"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnRenew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Renew Membership"
            android:backgroundTint="@color/status_available"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnCancelMembership"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cancel Membership"
            android:backgroundTint="@color/status_warning"
            android:textColor="@color/text_white" />

    </LinearLayout>

</LinearLayout>