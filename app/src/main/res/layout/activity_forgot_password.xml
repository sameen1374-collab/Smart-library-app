<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/bg_cream">

    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/logo_smart_library"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your email and we'll send you a reset link"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etResetEmail"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_input_field"
        android:textColor="@color/text_dark"
        android:textColorHint="@color/text_muted"/>

    <Button
        android:id="@+id/btnSendReset"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Send Reset Link"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/brown_primary"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvBackToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Login"
        android:textColor="@color/brown_primary"
        android:layout_marginTop="20dp"
        android:textSize="14sp"/>

</LinearLayout>