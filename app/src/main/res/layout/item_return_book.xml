<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_white_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="1dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        tools:text="The Great Gatsby" />

    <TextView
        android:id="@+id/tvAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="@color/brown_primary"
        tools:text="by F. Scott Fitzgerald" />

    <TextView
        android:id="@+id/tvDates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        tools:text="Issued: 8/3/2026    Due: 8/17/2026" />

    <TextView
        android:id="@+id/tvFineWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/status_warning"
        android:visibility="gone"
        tools:text="⚠ Overdue! Fine: Rs 20"
        tools:visibility="visible" />

    <Button
        android:id="@+id/btnReturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Return Book"
        android:backgroundTint="@color/status_available"
        android:textColor="@color/text_white" />

</LinearLayout>